{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.development)",
      "Read(**/.env.production)",
      "Read(**/.env.test)",
      "Read(**/.env.*.local)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.development)",
      "Edit(**/.env.production)",
      "Edit(**/.env.test)",
      "Edit(**/.env.*.local)"
    ],
    "allow": [
      "Bash(npm ci *)",
      "Bash(npm run lint *)",
      "Bash(npm test *)",
      "Bash(npm run build *)",
      "Bash(npm run test:e2e *)",
      "Bash(npx tsc --noEmit *)",
      "Bash(npm audit)",
      "Bash(npm audit --omit=dev)",
      "Bash(npm outdated *)",
      "Bash(npm view *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch)",
      "Bash(git branch -a)",
      "Bash(git branch --show-current)"
    ]
  }
}
