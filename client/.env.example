# Next.js site (client/). Copy to client/.env.local for local development; on
# Vercel, set these under Project Settings > Environment Variables. Never
# commit real values.
#
# NEXT_PUBLIC_* values are built into the pages and the browser's JavaScript:
# they must be public. Changing one needs a new build.

# The Express API's base URL, including /api. The browser calls it (chat,
# sign-in, dashboards) and so does the Next server. Locally: the API's port.
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# This site's own origin: canonical URLs, Open Graph, the sitemap and
# robots.txt. Production: https://your-domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional, server-only: a GitHub token (no scopes) for the home page's
# "Recently on GitHub" list. Without it, GitHub's lower anonymous rate limit
# applies. Never prefix it with NEXT_PUBLIC_.
GITHUB_API_TOKEN=
