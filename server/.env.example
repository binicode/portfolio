# Express API (server/). Copy to server/.env for local development; on a host,
# set these in its environment settings. Never commit real values.
# Validated at start-up by src/core/config/env.ts: a missing required value
# stops the server with the variable's name.

# --- Core ---
# development | production | test. Production turns on Secure cookies, HSTS,
# JSON logs and the stricter chat rate limit.
NODE_ENV=development
# The port to listen on. Most hosts set PORT themselves.
PORT=4000

# --- Database (required) ---
# MongoDB connection string. Atlas: Database > Connect > Drivers. Locally:
# mongodb://127.0.0.1:27017/portfolio. Without a reachable database the API
# still starts (the assistant answers from built-in notes) and retries.
MONGODB_URI=mongodb://127.0.0.1:27017/portfolio
# Optional DNS resolvers for the Atlas SRV lookup, comma-separated, for
# networks that can't resolve SRV records. Empty in production uses the
# host's resolver; development defaults to 8.8.8.8,8.8.4.4.
DNS_SERVERS=

# --- CORS and redirects ---
# The site's origin, or a comma-separated list (for example the site and a
# preview domain). Exact origins, no paths. The first one is where Stripe
# Checkout sends customers back.
CLIENT_ORIGIN=http://localhost:3000
# How many reverse proxies sit in front of the API, so rate limits see each
# visitor's IP instead of the proxy's. Empty when the API is reached directly
# (local development). Most hosts (Render, Railway, Heroku, Fly.io) put one
# proxy in front: set 1. Never "true": any caller could fake its IP.
TRUST_PROXY=

# --- Auth (required) ---
# The site's domain when the API runs on another host of it (site on
# example.com, API on api.example.com): COOKIE_DOMAIN=example.com, so the
# site's server can read the session to render the dashboards. Leave empty
# locally and when both run on one host.
COOKIE_DOMAIN=
# Signs session tokens. A long random string, unique per environment:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# The CMS admin account (/login). The hash is bcrypt:
# node -e "console.log(require('bcryptjs').hashSync(process.argv[1], 12))" 'your-password'
# (run inside server/ after npm ci)
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# --- AI assistant ---
# Google Gemini (answers) and Voyage AI (embeddings for retrieval). Without a
# Gemini key the assistant says it can't answer right now; without a Voyage
# key it matches notes by keyword instead of by meaning.
GEMINI_API_KEY=
VOYAGE_API_KEY=
# The most the assistant and the planner may spend on Gemini per UTC day, in
# US dollars at paid-tier prices (the free tier is counted the same way).
# Over it they answer "try again tomorrow", and ALERT_EMAIL_TO gets one email.
# Default 1.
AI_DAILY_COST_CAP_USD=

# --- Creator Dashboard billing (Stripe) ---
# Secret key (sk_test_... or sk_live_...), the webhook endpoint's signing
# secret (whsec_..., README "Stripe webhook"), and the recurring price the
# subscription sells (price_...).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=

# --- Creator Dashboard data sources ---
# GitHub token (no scopes needed; raises the rate limit) and a YouTube Data
# API v3 key. Hacker News needs no key.
GITHUB_API_TOKEN=
YOUTUBE_API_KEY=

# --- Email (Resend) ---
# Sends confirmation and password-reset links, and new-enquiry alerts.
# Without a key email is off; in development each message is printed to
# the console instead, so its link can be followed. The key needs only
# "Sending access". EMAIL_FROM must be on the domain verified in Resend
# (for example: Biniyam <hello@mail.example.com>).
RESEND_API_KEY=
EMAIL_FROM=
# Your inbox for new-enquiry alerts (replying answers the visitor). No
# alerts without it.
ALERT_EMAIL_TO=
