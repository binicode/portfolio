# --- Core server ---
NODE_ENV=development
PORT=4000

# --- Database ---
MONGODB_URI=mongodb://localhost:27017/portfolio

# --- CORS ---
CLIENT_ORIGIN=http://localhost:3000

# --- Proxies in front of the API ---
# How many reverse proxies sit in front of the API, so rate limits see each
# visitor's IP instead of the proxy's. Leave empty when the API is reached
# directly (local development). Most hosts (Render, Railway, Heroku, Fly.io)
# put one proxy in front: set 1. Never "true": any caller could fake its IP.
TRUST_PROXY=

# --- Auth (required once admin-cms / saas-mvp modules are active) ---
JWT_SECRET=7f0c3d28d18722858a9073a48c80cb4b2d1d750a2dbc35f8cfc4113c7f05ccce

# --- AI chat module ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- SaaS MVP billing module ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Storefront module ---
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_STORE_DOMAIN=